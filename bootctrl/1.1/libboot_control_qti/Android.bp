filegroup {
    name: "libboot_control_qti_src",
    srcs: ["libboot_control_qti.cpp"],
}

cc_library_headers {
    name: "libboot_control_qti_headers.motorola_sm6150",
    vendor: true,
    recovery_available: true,
    export_include_dirs: ["."],
}

cc_defaults {
    name: "libboot_control_qti_defaults",
    vendor: true,
    recovery_available: true,
    shared_libs: [
        "android.hardware.boot@1.1",
        "libbase",
        "libcutils",
        "liblog",
        "libz",
    ],
    static_libs: [
        "libboot_control",
        "libbootloader_message_vendor",
        "libfstab",
    ],
    owner: "qti",
    cflags: [
        "-Wall",
        "-Werror",
    ] + select(soong_config_variable("QTI_GPT_UTILS", "XBL_SLOT_BY_GPT_ATTRIBUTES"), {
        true: ["-DXBL_SLOT_BY_GPT_ATTRIBUTES"],
        default: [],
    }),
    srcs: [
        ":libboot_control_qti_src",
    ],
    header_libs: ["libboot_control_qti_headers.motorola_sm6150"],
}
